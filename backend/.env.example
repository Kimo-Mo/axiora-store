# Axiora Store backend environment template.
# Copy to `.env` and fill in local values: `cp .env.example .env`
# Never commit real secrets — `.env` is git-ignored.

# PostgreSQL connection string (Prisma datasource)
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/axiora_dev"

# HTTP server port (defaults to 5000 when unset)
PORT=5000

# Runtime environment: development | production | test
NODE_ENV=development

# JWT signing secret for the 15-minute access token (use a long random string in production)
# There is deliberately NO refresh secret: refresh tokens are opaque random strings
# stored only as a SHA-256 digest, so nothing signs or verifies them.
JWT_ACCESS_SECRET=your-access-secret-here

# Public origin of the Next.js storefront. Used as the CSRF allowlist for mutating
# requests (Origin / Referer validation) and as the CORS allowlist. Required.
FRONTEND_URL="http://localhost:3000"

# Cookie domain scope. Leave EMPTY in development — a `localhost` cookie domain
# behaves inconsistently across browsers. Set to the registrable domain in production.
COOKIE_DOMAIN=

# Initial admin user created by `npx prisma db seed`
ADMIN_EMAIL=admin@axiora.com
ADMIN_PASSWORD=AdminPass123!

# Cloudinary credentials for product image uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# SMS vendor selector for OTP delivery; only 'mock' exists until a production vendor is wired
SMS_PROVIDER=mock

# Payment vendor selector for online payment initiation and settlement. Only 'paymob'
# exists in this phase.
PAYMENT_PROVIDER=paymob

# Paymob Accept credentials (Egypt — https://accept.paymob.com/). All FIVE are optional:
# when they are absent the app still boots and simply reports online payments disabled,
# so the COD checkout keeps working on a machine without merchant credentials.
# Paste the test-mode values while developing — test and live share the same base URL and
# the mode is chosen by which keys you paste (sk_test/pk_test vs sk_live/pk_live).
#
# API Key           → mints the auth token for the Intention API
# Secret Key        → authenticates POST /v1/intention
# Public Key        → used to build the hosted-checkout redirect URL
# Integration ID(s) → the payment methods enabled for this merchant (comma-separated
#                     for several, e.g. "4569876,4569877")
# HMAC Secret       → SEPARATE from the keys above; authenticates inbound webhooks
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
