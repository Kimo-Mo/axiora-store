# Axiora Store backend environment template.
# Copy to `.env` and fill in local values: `cp .env.example .env`
# Never commit real secrets — `.env` is git-ignored.

# PostgreSQL connection string (Prisma datasource)
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/axiora_dev"

# HTTP server port (defaults to 5000 when unset)
PORT=5000

# Runtime environment: development | production | test
NODE_ENV=development

# JWT signing secrets (use long random strings in production)
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# Initial admin user created by `npx prisma db seed`
ADMIN_EMAIL=admin@axiora.com
ADMIN_PASSWORD=AdminPass123!

# Cloudinary credentials for product image uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
